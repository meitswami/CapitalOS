{
  "name": "capitalos",
  "version": "1.0.0",
  "private": true,
  "description": "Capital Intelligence Operating System",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @capitalos/database generate",
    "db:migrate": "pnpm --filter @capitalos/database migrate",
    "db:push": "pnpm --filter @capitalos/database push",
    "db:seed": "pnpm --filter @capitalos/database seed",
    "db:studio": "pnpm --filter @capitalos/database studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
